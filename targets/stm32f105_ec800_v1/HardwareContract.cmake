set(ABOX_BOARD_VERSION "v2" CACHE STRING "ABox PCB version: v1 (4 inputs) or v2 (8 inputs)")
set_property(CACHE ABOX_BOARD_VERSION PROPERTY STRINGS v1 v2)

function(abox_hardware_validate target config_dir scheduler)
    if(ABOX_BOARD_VERSION STREQUAL "v1")
        set(board_version_id 1)
    elseif(ABOX_BOARD_VERSION STREQUAL "v2")
        set(board_version_id 2)
    else()
        message(FATAL_ERROR "ABOX_BOARD_VERSION must be v1 or v2")
    endif()
    if(NOT config_dir OR NOT EXISTS "${config_dir}/abox_product_config.h")
        message(FATAL_ERROR "stm32f105_ec800_v1 requires abox_product_config.h")
    endif()
    file(READ "${config_dir}/abox_product_config.h" product_config)
    if(NOT product_config MATCHES "ABOX_SCHEDULER_${scheduler}")
        message(FATAL_ERROR "stm32f105_ec800_v1 scheduler disagrees with product config")
    endif()
    target_include_directories(${target} PRIVATE "${config_dir}")
    target_compile_definitions(${target} PRIVATE ABOX_BOARD_VERSION=${board_version_id})
    if(board_io IN_LIST ABOX_COMPONENTS)
        target_sources(${target} PRIVATE
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/board_io_stm32f105.c")
        target_include_directories(${target} PRIVATE
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/include")
    endif()
endfunction()
