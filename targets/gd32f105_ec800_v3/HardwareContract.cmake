set(ABOX_BOARD_VERSION "v3" CACHE STRING "ABox PCB version for GD32F105 target")
set_property(CACHE ABOX_BOARD_VERSION PROPERTY STRINGS v3)
function(abox_hardware_validate target config_dir scheduler)
    if(NOT ABOX_BOARD_VERSION STREQUAL "v3")
        message(FATAL_ERROR "gd32f105_ec800_v3 supports only ABOX_BOARD_VERSION=v3")
    endif()
    if(NOT config_dir OR NOT EXISTS "${config_dir}/abox_product_config.h")
        message(FATAL_ERROR "gd32f105_ec800_v3 requires abox_product_config.h")
    endif()
    file(READ "${config_dir}/abox_product_config.h" product_config)
    if(NOT product_config MATCHES "ABOX_SCHEDULER_${scheduler}")
        message(FATAL_ERROR "gd32f105_ec800_v3 scheduler disagrees with product config")
    endif()
    target_compile_definitions(${target} PRIVATE ABOX_BOARD_V3=1)
    target_include_directories(${target} PRIVATE "${config_dir}")
    if(board_io IN_LIST ABOX_COMPONENTS)
        target_sources(${target} PRIVATE
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../hardware/boards/abox_v3/board_io_v3.c")
    endif()
endfunction()
