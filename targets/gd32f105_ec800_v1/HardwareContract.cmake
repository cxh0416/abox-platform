set(ABOX_BOARD_VERSION "v1" CACHE STRING "ABox PCB version for GD32F105 target")
set_property(CACHE ABOX_BOARD_VERSION PROPERTY STRINGS v1)
function(abox_hardware_validate target config_dir scheduler)
    if(NOT ABOX_BOARD_VERSION STREQUAL "v1")
        message(FATAL_ERROR "gd32f105_ec800_v1 supports only ABOX_BOARD_VERSION=v1")
    endif()
    if(NOT config_dir OR NOT EXISTS "${config_dir}/abox_product_config.h")
        message(FATAL_ERROR "gd32f105_ec800_v1 requires abox_product_config.h")
    endif()
    file(READ "${config_dir}/abox_product_config.h" product_config)
    if(NOT product_config MATCHES "ABOX_SCHEDULER_${scheduler}")
        message(FATAL_ERROR "gd32f105_ec800_v1 scheduler disagrees with product config")
    endif()
    target_include_directories(${target} PRIVATE "${config_dir}")
    if(board_io IN_LIST ABOX_COMPONENTS)
        target_sources(${target} PRIVATE
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../hardware/mcu/gd32f105/board_io_gd32f105_v1.c")
    endif()
endfunction()
